# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection URL (SQLAlchemy format)
DATABASE_URL=postgresql+psycopg2://qd:qd_secret@localhost:5432/qddb

# PaySwift sandbox base URL (no trailing slash)
PAYSWIFT_BASE_URL=http://localhost:8081

# Gemini API key (free tier is enough)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model name. gemini-3.8-flash verified available 2026-10-29.
# Override if you want to use a different model (e.g. gemini-2.5-flash).
GEMINI_MODEL=gemini-3.8-flash

# Gemini API call timeout in seconds (per send_message, not total wall time).
GEMINI_TIMEOUT=45

# Paths to seed data CSVs (defaults work inside Docker)
RIDERS_CSV=/data/riders.csv
TRIPS_CSV=/data/trips.csv
PAYOUT_LINES_CSV=/data/payout_lines.csv
CONVERSATIONS_JSON=/data/conversations.json

# PaySwift retry settings
PAYSWIFT_MAX_RETRIES=3
PAYSWIFT_TIMEOUT=10
